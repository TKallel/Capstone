   "source": [
    "# -----------------------------------------------------------------\n",
    "#  Y TRANSFORMATION\n",
    "#\n",
    "#  signed_log10(y) = sign(y) * log10(|y| + eps)\n",
    "#\n",
    "#  np.abs(y)     : work with magnitude first\n",
    "#  + EPS         : prevents log10(0) returning -inf\n",
    "#  np.log10(...) : compresses 1e-248 to roughly -248\n",
    "#  np.sign(y) *  : restores the original sign\n",
    "# -----------------------------------------------------------------\n",
    "EPS = 1e-300        # prevents log10(0)\n",
    "\n",
    "\n",
    "def signed_log10(y):\n",
    "    return np.sign(y) * np.log10(np.abs(y) + EPS)\n",
    "\n",
    "\n",
    "Y = signed_log10(Y_raw)\n",
    "\n",
    "print(f\"Y_raw range   : [{Y_raw.min():.3e}, {Y_raw.max():.3e}]\")\n",
    "print(f\"Y_trans range : [{Y.min():.3f}, {Y.max():.3f}]\")\n",
    "\n",
    "print(\"\\nEffect of the transform:\")\n",
    "print(f\"{'X':<24}{'Y_raw':>16}{'signed_log10':>16}\")\n",
    "for i in range(len(Y_raw)):\n",
    "    point = f\"[{X[i, 0]:.4f}, {X[i, 1]:.4f}]\"\n",
    "    print(f\"{point:<24}{Y_raw[i]:>16.3g}{Y[i]:>16.2f}\")"
   ]
  },
