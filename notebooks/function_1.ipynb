    "# -----------------------------------------------------------------\n",
    "#  PREDICTION GRID\n",
    "# -----------------------------------------------------------------\n",
    "n_grid  = 100\n",
    "x1_grid = np.linspace(0, 1, n_grid)\n",
    "x2_grid = np.linspace(0, 1, n_grid)\n",
    "\n",
    "X1_mesh, X2_mesh = np.meshgrid(x1_grid, x2_grid)\n",
    "X_grid = np.column_stack([X1_mesh.ravel(), X2_mesh.ravel()])\n",
    "\n",
    "post_mean, post_std = model.predict(X_grid, return_std=True)\n",
    "\n",
    "post_mean_mesh = post_mean.reshape(n_grid, n_grid)\n",
    "post_std_mesh  = post_std.reshape(n_grid, n_grid)\n",
    "\n",
    "# UCB acquisition, on the transformed scale\n",
    "acquisition      = post_mean + beta * post_std\n",
    "acquisition_mesh = acquisition.reshape(n_grid, n_grid)\n",
    "\n",
    "# -----------------------------------------------------------------\n",
    "#  NEXT SAMPLE\n",
    "# -----------------------------------------------------------------\n",
    "max_idx = np.argmax(acquisition)\n",
    "x_next  = X_grid[max_idx]\n",
    "\n",
    "print(f\"Next point to sample  : [{x_next[0]:.6f}, {x_next[1]:.6f}]\")\n",
    "print(f\"Max acquisition value : {np.max(acquisition):.4f} (transformed scale)\")\n",
    "\n",
    "# How far is this from anything already measured?\n",
    "nearest = np.linalg.norm(X - x_next, axis=1).min()\n",
    "print(f\"Distance to nearest observation: {nearest:.4f}\")"
   ]
